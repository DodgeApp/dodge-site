{
  "redirects": [
    {
      "source": "/download",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(iPhone|iPad|iPod).*"
        }
      ],
      "destination": "https://apps.apple.com/app/id6762295432",
      "permanent": false
    },
    {
      "source": "/download",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*Android.*"
        }
      ],
      "destination": "https://play.google.com/store/apps/details?id=com.dodgeapp.app",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api|assets|.*\\..*).*)",
      "destination": "/"
    }
  ]
}
